{
	"name": "organic_harvest_backend",
	"version": "1.0.0",
	"description": "Backend for the web application Organic Harvest Ecommerce",
	"author": "Eslam Waleed",
	"type": "module",
	"main": "server.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"start": "node server.js",
		"dev": "nodemon server.js",
		"stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.expired --forward-to localhost:5000/api/payments/webhook",
		"devStart": "concurrently -n SERVER,STRIPE \"npm run dev\" \"npm run stripe:listen\""
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.7",
		"express": "^5.3.0",
		"google-auth-library": "^11.3.1",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^9.11.2",
		"nodemailer": "^10.1.2",
		"nodemon": "^3.1.14",
		"stripe": "^23.0.1"
	},
	"allowScripts": {
		"bcrypt@6.0.0": true
	},
	"devDependencies": {
		"concurrently": "^10.0.6"
	}
}
